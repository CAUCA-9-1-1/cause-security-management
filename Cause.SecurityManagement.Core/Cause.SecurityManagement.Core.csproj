<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <ApplicationIcon />
    <OutputType>Library</OutputType>
    <StartupObject />
    <Authors>Fred Catellier-Poulin, Michael Jolin, Claudine Gagnon</Authors>
    <Company>CAUCA 9-1-1</Company>
    <RepositoryUrl>https://github.com/CAUCA-9-1-1/cause-security-management</RepositoryUrl>
    <PackageProjectUrl>https://github.com/CAUCA-9-1-1/cause-security-management</PackageProjectUrl>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Description>Core security services for ASP.NET Core: authentication, authorization, user management and repositories.</Description>
    <Copyright>CAUCA 9-1-1 (c) 2025</Copyright>
    <PackageTags>Cause Security Management Core AspNetCore Cauca</PackageTags>
    <PackageReleaseNotes>
11.0.0 - Adds .NET 11 support. The packages now target both net10.0 and net11.0. There is no API
or behaviour change in this release: it carries the same code as 10.10.0.

.NET 10 consumers can take 11.x as-is; the MAJOR version tracks the highest .NET major the packages
target, not a breaking change. Applications on .NET 11 now resolve the .NET 11 builds of
Microsoft.AspNetCore.Authentication.JwtBearer and Cause.Core.DataLayerExtensions.

All published packages must be upgraded together. See
docs/adr/records/2026-11-23-multi-target-frameworks-and-central-package-management.md.
    </PackageReleaseNotes>
    <Version>11.0.0</Version>
    <Configurations>Debug;Release;NuGet</Configurations>
    <AssemblyVersion>11.0.0</AssemblyVersion>
    <FileVersion>11.0.0</FileVersion>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Cause.Core.DataLayerExtensions" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Semver" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\Cause.SecurityManagement.Models\Cause.SecurityManagement.Models.csproj" />
  </ItemGroup>
    
</Project>
